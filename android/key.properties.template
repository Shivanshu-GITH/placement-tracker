# PrepPilot release signing — TEMPLATE.
#
# 1. Create your upload keystore with `keytool -genkey -v -keystore <path>.jks \
#    -keyalg RSA -keysize 2048 -validity 10000 -alias upload`.
# 2. Copy this file to  android/key.properties  and fill in YOUR real values.
# 3. NEVER commit android/key.properties or the .jks keystore to git.
#    Losing this keystore means you can never push updates to the same Play listing.
#    Keep a secure backup (password manager / offline drive).

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
# Absolute path to your keystore file. Use forward slashes even on Windows.
storeFile=C:/Users/govin/keys/preppilot-upload.jks
